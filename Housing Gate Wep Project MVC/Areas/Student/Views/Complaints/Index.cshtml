@model IReadOnlyList<Complaint>
@{
    ViewData["Title"] = AL["Complaints.Title"];
}

<div class="page-head d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="mb-0">@AL["Complaints.Title"]</h1>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>@AL["Complaints.New"]</a>
</div>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-icon mb-3"><i class="bi bi-chat-square-dots"></i></div>
            <h4>@AL["Complaints.Empty"]</h4>
            <p class="mb-0"><a asp-action="Create" class="fw-semibold">@AL["Complaints.New"]</a></p>
        </div>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@AL["Complaints.Subject"]</th>
                    <th>@AL["Complaints.Type"]</th>
                    <th>@L["Common.Date"]</th>
                    <th>@L["Common.Status"]</th>
                    <th class="text-end">@L["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var complaint in Model)
                {
                    var cls = complaint.Status switch
                    {
                        ComplaintStatus.Resolved => "badge-success-soft",
                        ComplaintStatus.Open => "badge-warning-soft",
                        ComplaintStatus.UnderReview => "badge-info-soft",
                        _ => "badge-neutral-soft"
                    };
                    <tr>
                        <td>
                            <div class="fw-semibold">@complaint.Subject</div>
                            <small class="text-muted">
                                @if (complaint.TargetProperty != null)
                                {
                                    <text><i class="bi bi-building me-1"></i>@AL["Complaints.About"] @complaint.TargetProperty.Title</text>
                                }
                                else if (complaint.TargetUser != null)
                                {
                                    <text><i class="bi bi-person me-1"></i>@AL["Complaints.About"] @complaint.TargetUser.FullName</text>
                                }
                            </small>
                        </td>
                        <td><span class="badge badge-neutral-soft">@EnumDisplay.Get(complaint.ComplaintType, L)</span></td>
                        <td class="text-muted small">@complaint.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td><span class="badge @cls">@EnumDisplay.Get(complaint.Status, L)</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@complaint.Id" class="btn btn-sm btn-soft">@L["Common.View"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}