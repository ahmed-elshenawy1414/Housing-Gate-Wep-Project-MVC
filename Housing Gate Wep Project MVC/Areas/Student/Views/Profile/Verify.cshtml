@{
    ViewData["Title"] = AL["Profile.VerifyTitle"];
}

<div class="auth-shell">
    <div class="auth-card p-4 p-md-5">
        <div class="text-center mb-4">
            <span class="brand-mark mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.4rem;">
                <i class="bi bi-patch-check"></i>
            </span>
            <h1 class="h3 fw-bold mb-1">@AL["Profile.VerifyTitle"]</h1>
            <p class="text-muted mb-0">@AL["Profile.VerifyIntro"]</p>
        </div>

        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">@AL["Profile.NationalIdLabel"] <span class="text-danger">*</span></label>
                <label class="upload-zone d-block">
                    <i class="bi bi-cloud-arrow-up-fill fs-2 d-block mb-2" style="color: var(--brand-500);"></i>
                    <span class="small fw-semibold">@AL["Profile.UploadDocs"]</span>
                    <input type="file" name="nationalId" class="d-none" accept=".jpg,.jpeg,.png,.webp" required />
                </label>
            </div>
            <div class="mb-4">
                <label class="form-label">@AL["Profile.UniversityIdLabel"] <span class="text-danger">*</span></label>
                <label class="upload-zone d-block">
                    <i class="bi bi-cloud-arrow-up-fill fs-2 d-block mb-2" style="color: var(--brand-500);"></i>
                    <span class="small fw-semibold">@AL["Profile.UploadDocs"]</span>
                    <input type="file" name="universityId" class="d-none" accept=".jpg,.jpeg,.png,.webp" required />
                </label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-cloud-arrow-up me-1"></i>@AL["Profile.Upload"]</button>
                <a asp-action="Index" class="btn btn-soft">@AL["Common.Back"]</a>
            </div>
        </form>
    </div>
</div>