@model PropertySearchViewModel
@{
    ViewData["Title"] = L["Nav.FindHousing"];
}

<div class="page-head mb-4">
    <h1 class="mb-1">@L["Nav.FindHousing"]</h1>
    <p>@Model.TotalCount @AL["Search.ResultsCount"]</p>
</div>

<form method="get" class="card mb-4">
    <div class="card-body p-3">
        <div class="row g-2 g-lg-3 align-items-stretch">
            <div class="col-12 col-md-4 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="@AL["Search.KeywordPlaceholder"]" />
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                    <select name="city" class="form-select">
                        <option value="">@AL["Search.AllCities"]</option>
                        @foreach (var city in Model.Cities)
                        {
                            <option value="@city" selected="@(Model.City == city)">@city</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <select name="propertyType" class="form-select">
                    <option value="">@AL["Search.AllTypes"]</option>
                    @foreach (var type in Enum.GetValues<PropertyType>())
                    {
                        <option value="@type" selected="@(Model.PropertyType == type)">@EnumDisplay.Get(type, L)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="input-group">
                    <span class="input-group-text">@L["Common.CurrencySymbol"]</span>
                    <input type="number" name="maxRent" value="@Model.MaxRent" class="form-control" placeholder="@L["Home.MaxRent"]" />
                </div>
            </div>
            <div class="col-6 col-md-8 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>@L["Home.Search"]</button>
                <a asp-controller="Search" asp-action="Index" class="btn btn-soft" title="@L["Common.Cancel"]"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3 pt-3" style="border-top: 1px solid var(--line-soft);">
            <div class="d-flex align-items-center gap-2">
                <span class="small text-muted">@AL["Search.SortRecommended"]:</span>
                <div class="btn-group btn-group-sm" role="group">
                    <a asp-controller="Search" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-city="@Model.City"
                       asp-route-propertyType="@Model.PropertyType" asp-route-maxRent="@Model.MaxRent" asp-route-sortBy=""
                       class="btn btn-sm @(string.IsNullOrEmpty(Model.SortBy) ? "btn-primary" : "btn-soft")">@AL["Search.SortRecommended"]</a>
                    <a asp-controller="Search" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-city="@Model.City"
                       asp-route-propertyType="@Model.PropertyType" asp-route-maxRent="@Model.MaxRent" asp-route-sortBy="price-asc"
                       class="btn btn-sm @(Model.SortBy == "price-asc" ? "btn-primary" : "btn-soft")">@AL["Search.SortPriceAsc"]</a>
                    <a asp-controller="Search" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-city="@Model.City"
                       asp-route-propertyType="@Model.PropertyType" asp-route-maxRent="@Model.MaxRent" asp-route-sortBy="price-desc"
                       class="btn btn-sm @(Model.SortBy == "price-desc" ? "btn-primary" : "btn-soft")">@AL["Search.SortPriceDesc"]</a>
                    <a asp-controller="Search" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-city="@Model.City"
                       asp-route-propertyType="@Model.PropertyType" asp-route-maxRent="@Model.MaxRent" asp-route-sortBy="newest"
                       class="btn btn-sm @(Model.SortBy == "newest" ? "btn-primary" : "btn-soft")">@AL["Search.SortNewest"]</a>
                </div>
            </div>
            <span class="small text-muted">@Model.TotalCount @AL["Search.ResultsCount"]</span>
        </div>
    </div>
</form>

@if (Model.Results.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-icon mb-3"><i class="bi bi-search"></i></div>
            <h4>@AL["Search.NoResults"]</h4>
            <p class="mb-0">@L["Home.NoListings"]</p>
        </div>
    </div>
}
else
{
    <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-xl-3">
        @foreach (var property in Model.Results)
        {
            <partial name="_PropertyCard" model="property" />
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-center align-items-center gap-2 mt-4">
            <span class="small text-muted">@string.Format(AL["Search.PageInfo"] ?? "Page {0} of {1} ({2} results)", Model.Page, Model.TotalPages, Model.TotalCount)</span>
            <div class="btn-group btn-group-sm">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-city="@Model.City" asp-route-propertyType="@Model.PropertyType" asp-route-maxRent="@Model.MaxRent" asp-route-sortBy="@Model.SortBy" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" class="btn btn-soft"><i class="bi bi-chevron-left"></i> @L["Common.Previous"]</a>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-city="@Model.City" asp-route-propertyType="@Model.PropertyType" asp-route-maxRent="@Model.MaxRent" asp-route-sortBy="@Model.SortBy" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" class="btn btn-soft">@L["Common.Next"] <i class="bi bi-chevron-right"></i></a>
                }
            </div>
        </nav>
    }
}