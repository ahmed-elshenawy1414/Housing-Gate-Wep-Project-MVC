@{
    ViewData["Title"] = AL["Reviews.ReviewRoommate"];
    var stayId = (int)ViewBag.StayId;
    var reviewedUserId = (string)ViewBag.ReviewedUserId;
    var reviewedUserName = (string)ViewBag.ReviewedUserName;
}

<div class="auth-shell">
    <div class="auth-card p-4 p-md-5">
        <div class="text-center mb-4">
            <span class="brand-mark mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.4rem;">
                <i class="bi bi-people-fill"></i>
            </span>
            <h1 class="h3 fw-bold mb-1">@AL["Reviews.ReviewRoommateTitle"]</h1>
            <p class="text-muted mb-0">@AL["Reviews.ReviewRoommateSub"] <strong>@reviewedUserName</strong>?</p>
        </div>

        <form method="post">
            <input type="hidden" name="stayId" value="@stayId" />
            <input type="hidden" name="userId" value="@reviewedUserId" />

            <div class="mb-3">
                <label class="form-label">@AL["Reviews.Rating"]</label>
                <div class="d-flex gap-1" role="group">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <input type="radio" class="btn-check" name="rating" id="rating@i" value="@i" @(i == 5 ? "checked" : "") />
                        <label class="btn btn-outline-warning flex-grow-1" for="rating@i" style="--bs-btn-hover-bg: var(--accent-500); --bs-btn-active-bg: var(--accent-500);"><i class="bi bi-star-fill"></i></label>
                    }
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">@AL["Reviews.Comment"]</label>
                <textarea name="comment" class="form-control" rows="5" placeholder="@AL["Reviews.CommentPlaceholder2"]"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-send me-1"></i>@AL["Reviews.Submit"]</button>
                <a asp-controller="Stays" asp-action="Index" class="btn btn-soft">@L["Common.Cancel"]</a>
            </div>
        </form>
    </div>
</div>