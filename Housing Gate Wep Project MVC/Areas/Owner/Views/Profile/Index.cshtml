@model OwnerProfileViewModel
@{
    ViewData["Title"] = AL["OProfile.Title"];
}

<div class="container py-4" style="max-width: 820px;">
    <div class="page-head mb-4">
        <h1 class="mb-0">@AL["OProfile.MyProfile"]</h1>
    </div>

    @if (Model.VerificationStatus == VerificationStatus.Verified)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-patch-check-fill fs-4"></i>
            <div>
                @AL["OProfile.VerifiedBanner"] <strong>@EnumDisplay.Get(VerificationStatus.Verified, L)</strong>.
                @if (Model.VerifiedAt.HasValue) { <text>@AL["OProfile.VerifiedSince"] @Model.VerifiedAt.Value.ToLocalTime().ToString("dd MMM yyyy").</text> }
            </div>
        </div>
    }
    else if (Model.VerificationStatus == VerificationStatus.Pending)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-hourglass-split fs-4"></i>
            <div>@AL["OProfile.PendingBanner"]</div>
        </div>
    }
    else if (Model.VerificationStatus == VerificationStatus.Rejected)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-x-octagon-fill fs-4"></i>
            <div>@AL["OProfile.RejectedBanner"] <a asp-action="Verify" class="fw-semibold">@AL["OProfile.UploadClearerDoc"]</a>.</div>
        </div>
    }
    else
    {
        <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-patch-question fs-4"></i>
            <div>@AL["OProfile.NotVerified"] <a asp-action="Verify" class="fw-semibold">@AL["OProfile.VerifyOwnership"]</a> @AL["OProfile.ToUnlockBadge"]</div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" class="avatar-image avatar-lg" style="width:64px;height:64px;" alt="" />
            }
            else
            {
                <span class="avatar-initials avatar-lg" style="width: 64px; height: 64px; font-size: 1.4rem;">
                    @string.Concat(Model.FirstName.Split(' ').Take(1).Select(p => p[0]))@string.Concat(Model.LastName.Split(' ').Take(1).Select(p => p[0]))
                </span>
            }
            <div class="flex-grow-1 min-width-0">
                <div class="h5 fw-bold mb-0">@Model.FirstName @Model.LastName</div>
                <div class="text-muted small text-truncate">@Model.Email</div>
            </div>
            <a asp-action="Edit" class="btn btn-soft"><i class="bi bi-pencil-square me-1"></i>@L["Common.Edit"]</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0 g-2">
                <dt class="col-sm-3 fw-semibold text-muted">@AL["OProfile.Company"]</dt>
                <dd class="col-sm-9">@(Model.CompanyName ?? "-")</dd>
                <dt class="col-sm-3 fw-semibold text-muted">@AL["OProfile.Phone"]</dt>
                <dd class="col-sm-9">@(Model.Phone ?? "-")</dd>
                <dt class="col-sm-3 fw-semibold text-muted">@AL["OProfile.License"]</dt>
                <dd class="col-sm-9">@(Model.LicenseNumber ?? "-")</dd>
                <dt class="col-sm-3 fw-semibold text-muted">@AL["OProfile.Bio"]</dt>
                <dd class="col-sm-9">@(Model.Bio ?? "-")</dd>
            </dl>
        </div>
    </div>
</div>