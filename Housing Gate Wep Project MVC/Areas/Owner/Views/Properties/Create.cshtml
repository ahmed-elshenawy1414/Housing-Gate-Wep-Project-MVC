@model PropertyFormViewModel
@{
    ViewData["Title"] = AL["Props.AddTitle"];
}

<div class="container py-4" style="max-width: 960px;">
    <div class="page-head mb-4">
        <h1 class="mb-0">@AL["Props.AddHeading"]</h1>
    </div>

    <form method="post" enctype="multipart/form-data" class="card">
        <div class="card-body p-4 p-lg-5">
            <partial name="_PropertyForm" model="Model" />
            <hr />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>@AL["Props.SubmitListing"]</button>
                <a asp-action="Index" class="btn btn-soft">@L["Common.Cancel"]</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}