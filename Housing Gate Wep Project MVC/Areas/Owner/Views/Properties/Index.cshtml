@model IReadOnlyList<Property>
@{
    ViewData["Title"] = AL["Props.Title"];
}

<div class="page-head d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="mb-0">@AL["Props.Title"]</h1>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>@AL["Props.Add"]</a>
</div>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-icon mb-3"><i class="bi bi-houses"></i></div>
            <h4>@AL["Props.Empty"]</h4>
            <p class="mb-0"><a asp-action="Create" class="fw-semibold">@AL["Props.Add"]</a></p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var property in Model)
        {
            var primaryImage = property.Images.FirstOrDefault(i => i.IsPrimary)?.FilePath
                               ?? property.Images.FirstOrDefault()?.FilePath
                               ?? "/images/property-placeholder.svg";
            var minRent = property.Rooms.Where(r => r.IsAvailable).Select(r => r.RentPerMonth).DefaultIfEmpty(0).Min();
            var statusCls = property.ApprovalStatus switch
            {
                ApprovalStatus.Approved => "badge-success-soft",
                ApprovalStatus.Rejected => "badge-danger-soft",
                ApprovalStatus.Draft => "badge-neutral-soft",
                ApprovalStatus.Suspended => "badge-danger-soft",
                ApprovalStatus.Archived => "badge-neutral-soft",
                _ => "badge-warning-soft"
            };

            <div class="col-md-6 col-xl-4">
                <div class="card card-hover property-card h-100 overflow-hidden">
                    <div class="card-img-wrap">
                        <img src="@primaryImage" alt="@property.Title" />
                        <div class="card-badges">
                            <span class="badge @statusCls">@EnumDisplay.Get(property.ApprovalStatus, L)</span>
                            @if (!property.IsActive)
                            {
                                <span class="badge badge-neutral-soft">@AL["Props.Hidden"]</span>
                            }
                        </div>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h6 class="fw-bold mb-1">@property.Title</h6>
                        <div class="property-meta-line mb-2">
                            <i class="bi bi-geo-alt-fill" style="color: var(--brand-500);"></i>
                            <span class="text-truncate">@property.City, @property.State</span>
                        </div>

                        @if (property.ApprovalStatus == ApprovalStatus.Rejected && !string.IsNullOrEmpty(property.AdminNote))
                        {
                            <div class="alert alert-danger py-1 px-2 small mb-2">
                                <strong>@AL["Props.Reason"]</strong> @property.AdminNote
                            </div>
                        }

                        <div class="d-flex flex-wrap align-items-center gap-2 small text-muted mt-auto mb-3">
                            @if (minRent > 0)
                            {
                                <span class="property-price">@minRent.ToString("N0") @L["Common.CurrencySymbol"]<span class="text-muted small fw-normal">/ @L["Card.PerMonth"]</span></span>
                            }
                            <span class="badge badge-neutral-soft"><i class="bi bi-door-closed me-1"></i>@property.Rooms.Count @AL["Props.RoomsCount"]</span>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-action="Edit" asp-route-id="@property.Id" class="btn btn-sm btn-soft"><i class="bi bi-pencil me-1"></i>@L["Common.Edit"]</a>
                            <form method="post" asp-action="ToggleActive" asp-route-id="@property.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-soft-secondary">
                                    <i class="bi @(property.IsActive ? "bi-eye-slash" : "bi-eye") me-1"></i>
                                    @(property.IsActive ? AL["Props.Hide"] : AL["Props.Show"])
                                </button>
                            </form>
                            <form method="post" asp-action="Delete" asp-route-id="@property.Id" onsubmit="return confirm('@AL["Props.DeleteConfirm"]');" class="d-inline ms-auto">
                                <button type="submit" class="btn btn-sm btn-soft-danger"><i class="bi bi-trash me-1"></i>@AL["Props.Delete"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}