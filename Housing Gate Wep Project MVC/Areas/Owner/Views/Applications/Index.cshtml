@model IReadOnlyList<PropertyApplication>
@{
    ViewData["Title"] = AL["Apps.Title"];
}

<div class="page-head mb-4">
    <h1 class="mb-0">@AL["Apps.Title"]</h1>
</div>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-icon mb-3"><i class="bi bi-inbox"></i></div>
            <h4>@AL["Apps.Empty"]</h4>
        </div>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@AL["Apps.Student"]</th>
                    <th>@AL["Apps.PropertyRoom"]</th>
                    <th>@AL["Apps.Message"]</th>
                    <th>@AL["Apps.Applied"]</th>
                    <th>@AL["Apps.Status"]</th>
                    <th class="text-end">@L["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model)
                {
                    var statusCls = app.Status switch
                    {
                        ApplicationStatus.Approved => "badge-success-soft",
                        ApplicationStatus.Rejected => "badge-danger-soft",
                        ApplicationStatus.Cancelled => "badge-neutral-soft",
                        _ => "badge-warning-soft"
                    };
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-initials avatar-initials-sm">@string.Concat(app.StudentProfile.User.FirstName?.FirstOrDefault(), app.StudentProfile.User.LastName?.FirstOrDefault())</span>
                                <div class="min-width-0">
                                    <div class="fw-semibold text-truncate">@app.StudentProfile.User.FullName</div>
                                    <small class="text-muted">@app.StudentProfile.University</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold text-truncate" style="max-width: 200px;">@app.Room.Property.Title</div>
                            <small class="text-muted">@app.Room.Name &middot; @app.Room.RentPerMonth.ToString("N0")@L["Card.PerMonth"]</small>
                        </td>
                        <td class="small text-muted" style="max-width: 260px;">
                            @if (!string.IsNullOrEmpty(app.Message))
                            {
                                <em>"@app.Message"</em>
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </td>
                        <td class="text-muted small">@app.AppliedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td><span class="badge @statusCls">@EnumDisplay.Get(app.Status, L)</span></td>
                        <td class="text-end">
                            @if (app.Status == ApplicationStatus.Pending)
                            {
                                <div class="d-flex gap-2 justify-content-end">
                                    <form method="post" asp-action="Respond" asp-route-id="@app.Id" asp-route-approve="true"
                                          onsubmit="return confirm('@AL["Apps.ApproveConfirm"]');">
                                        <button type="submit" class="btn btn-sm btn-soft-success"><i class="bi bi-check-lg me-1"></i>@AL["Apps.Approve"]</button>
                                    </form>
                                    <form method="post" asp-action="Respond" asp-route-id="@app.Id" asp-route-approve="false">
                                        <button type="submit" class="btn btn-sm btn-soft-danger"><i class="bi bi-x-lg me-1"></i>@AL["Apps.Reject"]</button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}