@model IReadOnlyList<AuditLog>
@{
    ViewData["Title"] = AL["Audit.Title"];
    var q = (string?)ViewBag.Query;
    var filterAction = (string?)ViewBag.FilterAction;
}

<div class="page-head d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="mb-0">@AL["Audit.Title"]</h1>
    </div>
</div>

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-md-5">
        <label class="form-label small text-muted mb-1">@AL["Audit.SearchPlaceholder"]</label>
        <div class="input-group">
            <span class="input-group-text bg-transparent text-muted border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" name="q" value="@q" class="form-control border-start-0" placeholder="@AL["Audit.SearchPlaceholder"]" />
        </div>
    </div>
    <div class="col-md-4">
        <label class="form-label small text-muted mb-1">@AL["Audit.FilterByAction"]</label>
        <select name="action" class="form-select">
            <option value="">@AL["Audit.AllActions"]</option>
            @foreach (var opt in (List<SelectListItem>)ViewBag.ActionOptions)
            {
                <option value="@opt.Value" selected="@(opt.Value == filterAction)">@opt.Text</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>@AL["Audit.Filter"]</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="empty-state"><i class="bi bi-clock-history"></i><p>@AL["Audit.Empty"]</p></div>
}
else
{
    <div class="table-wrapper">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@AL["Audit.ColTime"]</th>
                    <th>@AL["Audit.ColAdmin"]</th>
                    <th>@AL["Audit.ColAction"]</th>
                    <th>@AL["Audit.ColEntity"]</th>
                    <th>@AL["Audit.ColDetails"]</th>
                    <th>@AL["Audit.ColReason"]</th>
                    <th>@AL["Audit.ColIp"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="text-nowrap text-muted small">@log.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td class="fw-semibold">@log.PerformedBy.FullName</td>
                        <td><span class="badge badge-secondary-soft">@L["Audit.Action." + log.Action]</span></td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(log.EntityType))
                            {
                                <text>@L["Audit.Entity." + log.EntityType] @log.EntityId</text>
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </td>
                        <td class="small">@(log.Description ?? "-")</td>
                        <td class="text-muted small">@(log.Reason ?? "-")</td>
                        <td class="text-muted small">@(log.IpAddress ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}