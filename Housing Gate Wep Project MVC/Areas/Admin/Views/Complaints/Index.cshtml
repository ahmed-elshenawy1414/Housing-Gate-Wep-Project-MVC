@model IReadOnlyList<Complaint>
@{
    ViewData["Title"] = AL["Cmpl.Title"];
    var q = (string?)ViewBag.Query;
}

<div class="page-head d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="mb-0">@AL["Cmpl.Title"]</h1>
    </div>
</div>

<form method="get" class="mb-4">
    <div class="input-group" style="max-width: 420px;">
        <span class="input-group-text bg-transparent text-muted border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" name="q" value="@q" class="form-control border-start-0" placeholder="@L["Common.SearchPlaceholder"]" />
        <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>@L["Common.Search"]</button>
        @if (!string.IsNullOrEmpty(q))
        {
            <a asp-action="Index" class="btn btn-soft">@AL["Common.Cancel"]</a>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-shield-check"></i>
        <p>@AL["Cmpl.Empty"]</p>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@AL["Cmpl.ColId"]</th>
                    <th>@AL["Cmpl.ColFrom"]</th>
                    <th>@AL["Cmpl.ColProperty"]</th>
                    <th>@AL["Cmpl.ColType"]</th>
                    <th>@AL["Cmpl.ColStatus"]</th>
                    <th>@AL["Cmpl.ColDate"]</th>
                    <th class="text-end">@L["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var complaint in Model)
                {
                    <tr>
                        <td class="text-muted small">#@complaint.Id</td>
                        <td class="fw-semibold">@complaint.Complainant.FullName</td>
                        <td>@(complaint.TargetProperty?.Title ?? "-")</td>
                        <td>@EnumDisplay.Get(complaint.ComplaintType, L)</td>
                        <td>
                            <span class="badge @(complaint.Status == ComplaintStatus.Open ? "badge-danger-soft" : complaint.Status == ComplaintStatus.Resolved ? "badge-success-soft" : "badge-secondary-soft")">@EnumDisplay.Get(complaint.Status, L)</span>
                        </td>
                        <td class="text-muted small">@complaint.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@complaint.Id" class="btn btn-sm btn-soft"><i class="bi bi-eye me-1"></i>@AL["Cmpl.Review"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}