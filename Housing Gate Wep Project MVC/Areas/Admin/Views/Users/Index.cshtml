@model IReadOnlyList<UserWithRolesDto>
@{
    ViewData["Title"] = AL["Users.Title"];
    var q = (string?)ViewBag.Query;
}

<div class="page-head d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="mb-0">@AL["Users.Title"]</h1>
    </div>
    <div class="btn-group btn-group-sm" role="group">
        <a asp-action="Index" asp-route-q="@q" class="btn btn-primary px-3">@AL["Users.All"]</a>
        <a asp-action="Students" asp-route-q="@q" class="btn btn-soft px-3">@AL["Users.Students"]</a>
        <a asp-action="Owners" asp-route-q="@q" class="btn btn-soft px-3">@AL["Users.Owners"]</a>
    </div>
</div>

<form method="get" class="mb-4">
    <div class="input-group" style="max-width: 420px;">
        <span class="input-group-text bg-transparent text-muted border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" name="q" value="@q" class="form-control border-start-0" placeholder="@L["Common.SearchPlaceholder"]" />
        <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>@L["Common.Search"]</button>
        @if (!string.IsNullOrEmpty(q))
        {
            <a asp-action="Index" class="btn btn-soft">@AL["Common.Cancel"]</a>
        }
    </div>
</form>

<div class="table-wrapper">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>@AL["Users.ColName"]</th>
                <th>@AL["Users.ColEmail"]</th>
                <th>@AL["Users.ColRoles"]</th>
                <th>@AL["Users.ColActive"]</th>
                <th>@AL["Users.ColJoined"]</th>
                <th class="text-end">@L["Common.Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr class="@(user.User.IsActive ? "" : "opacity-50")">
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span class="avatar-initials avatar-initials-sm">@string.Concat(user.User.FirstName?.FirstOrDefault(), user.User.LastName?.FirstOrDefault())</span>
                            <span class="fw-semibold">@user.User.FullName</span>
                        </div>
                    </td>
                    <td class="small text-muted">@user.User.Email</td>
                    <td>
                        @foreach (var role in user.Roles)
                        {
                            <span class="badge @(role == "Admin" ? "badge-danger-soft" : role == "Owner" ? "badge-warning-soft" : "badge-primary-soft") me-1">@role</span>
                        }
                    </td>
                    <td>
                        <span class="badge @(user.User.IsActive ? "badge-success-soft" : "badge-danger-soft")">
                            <i class="bi @(user.User.IsActive ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                            @(user.User.IsActive ? AL["Users.Yes"] : AL["Users.No"])
                        </span>
                    </td>
                    <td class="text-muted small">@user.User.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Details" asp-route-id="@user.User.Id" class="btn btn-sm btn-soft">
                                <i class="bi bi-eye me-1"></i>@AL["Users.View"]
                            </a>
                            <form method="post" asp-action="ToggleActive" asp-route-userId="@user.User.Id"
                                  onsubmit="return confirm('@(user.User.IsActive ? AL["Users.DeactivateConfirm"] : AL["Users.ActivateConfirm"])');">
                                <button type="submit" class="btn btn-sm @(user.User.IsActive ? "btn-soft-danger" : "btn-soft-success")">
                                    <i class="bi @(user.User.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                                    @(user.User.IsActive ? AL["Users.Deactivate"] : AL["Users.Activate"])
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>