@model IReadOnlyList<PropertyReview>
@{
    ViewData["Title"] = AL["Rev.Title"];
    var pending = ViewBag.Pending as IReadOnlyList<PropertyReview> ?? new List<PropertyReview>();
    var q = (string?)ViewBag.Query;
}

<div class="page-head d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="mb-0">@AL["Rev.Title"]</h1>
    </div>
    @if (pending.Count > 0)
    {
        <span class="badge badge-warning-soft"><i class="bi bi-hourglass-split me-1"></i>@string.Format(AL["Rev.PendingCount"], pending.Count)</span>
    }
</div>

<form method="get" class="mb-4">
    <div class="input-group" style="max-width: 420px;">
        <span class="input-group-text bg-transparent text-muted border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" name="q" value="@q" class="form-control border-start-0" placeholder="@L["Common.SearchPlaceholder"]" />
        <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>@L["Common.Search"]</button>
        @if (!string.IsNullOrEmpty(q))
        {
            <a asp-action="Index" class="btn btn-soft">@AL["Common.Cancel"]</a>
        }
    </div>
</form>

@if (pending.Count > 0)
{
    <h2 class="h6 fw-bold text-uppercase text-muted mb-3">@AL["Rev.AwaitingModeration"]</h2>
    <div class="table-wrapper mb-4">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>@AL["Rev.ColStudent"]</th><th>@AL["Rev.ColProperty"]</th><th>@AL["Rev.ColRating"]</th><th>@AL["Rev.ColReview"]</th><th class="text-end">@L["Common.Actions"]</th></tr>
            </thead>
            <tbody>
                @foreach (var review in pending)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-initials avatar-initials-sm">@review.Reviewer.FullName.FirstOrDefault()</span>
                                <span class="fw-semibold">@review.Reviewer.FullName</span>
                            </div>
                        </td>
                        <td class="small">@review.Property.Title</td>
                        <td>
                            <span class="text-warning" aria-hidden="true">
                                @for (var i = 0; i < review.Rating; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                @for (var i = review.Rating; i < 5; i++)
                                {
                                    <i class="bi bi-star text-muted"></i>
                                }
                            </span>
                        </td>
                        <td class="small text-muted" style="max-width: 320px;"><span class="text-truncate d-block">@review.Comment</span></td>
                        <td class="text-end text-nowrap">
                            <form method="post" asp-action="Approve" asp-route-id="@review.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-soft-success"><i class="bi bi-check-lg me-1"></i>@AL["Rev.Approve"]</button>
                            </form>
                            <form method="post" asp-action="Remove" asp-route-id="@review.Id" class="d-inline ms-1"
                                  onsubmit="return confirm('@AL["Rev.RemoveConfirm"]');">
                                <button type="submit" class="btn btn-sm btn-soft-danger"><i class="bi bi-trash me-1"></i>@AL["Rev.Remove"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h6 fw-bold text-uppercase text-muted mb-3">@AL["Rev.AllReviews"]</h2>
@if (Model.Count == 0)
{
    <div class="empty-state"><i class="bi bi-chat-square-text"></i><p>@AL["Rev.NoPublished"]</p></div>
}
else
{
    <div class="table-wrapper">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>@AL["Rev.ColStudent"]</th><th>@AL["Rev.ColProperty"]</th><th>@AL["Rev.ColRating"]</th><th>@AL["Rev.ColReview"]</th><th>@AL["Rev.ColStatus"]</th><th class="text-end">@L["Common.Actions"]</th></tr>
            </thead>
            <tbody>
                @foreach (var review in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-initials avatar-initials-sm">@review.Reviewer.FullName.FirstOrDefault()</span>
                                <span class="fw-semibold">@review.Reviewer.FullName</span>
                            </div>
                        </td>
                        <td class="small">@review.Property.Title</td>
                        <td>
                            <span class="text-warning" aria-hidden="true">
                                @for (var i = 0; i < review.Rating; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                @for (var i = review.Rating; i < 5; i++)
                                {
                                    <i class="bi bi-star text-muted"></i>
                                }
                            </span>
                        </td>
                        <td class="small text-muted" style="max-width: 320px;"><span class="text-truncate d-block">@review.Comment</span></td>
                        <td><span class="badge @(review.Status == ReviewStatus.Approved ? "badge-success-soft" : "badge-secondary-soft")">@EnumDisplay.Get(review.Status, L)</span></td>
                        <td class="text-end">
                            <form method="post" asp-action="Remove" asp-route-id="@review.Id" class="d-inline"
                                  onsubmit="return confirm('@AL["Rev.RemoveConfirm"]');">
                                <button type="submit" class="btn btn-sm btn-soft-danger"><i class="bi bi-trash me-1"></i>@AL["Rev.Remove"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}