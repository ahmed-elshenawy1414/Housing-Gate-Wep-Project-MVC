@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer<StudentHousing.Resources.SharedResource> L
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var cultureName = CultureInfo.CurrentUICulture.Name;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsActive(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (a == null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="@cultureName" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    @await Html.PartialAsync("_LayoutHead")
</head>
<body class="app-body role-admin">
    @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminTopbar.cshtml")

    <nav class="app-nav-horizontal">
        <a class="app-nav-link @(IsActive("Dashboard") ? "active" : "")"
           asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-speedometer2 me-1"></i>@L["Nav.Dashboard"]
        </a>
        <a class="app-nav-link @(IsActive("Users") ? "active" : "")"
           asp-area="Admin" asp-controller="Users" asp-action="Index">
            <i class="bi bi-people me-1"></i>@L["Nav.Users"]
        </a>
        <a class="app-nav-link @(IsActive("Properties") ? "active" : "")"
           asp-area="Admin" asp-controller="Properties" asp-action="Index">
            <i class="bi bi-building me-1"></i>@L["Nav.Properties"]
        </a>
        <a class="app-nav-link @(IsActive("Complaints") ? "active" : "")"
           asp-area="Admin" asp-controller="Complaints" asp-action="Index">
            <i class="bi bi-shield-exclamation me-1"></i>@L["Nav.Complaints"]
        </a>
        <a class="app-nav-link @(IsActive("Reviews") ? "active" : "")"
           asp-area="Admin" asp-controller="Reviews" asp-action="Index">
            <i class="bi bi-star me-1"></i>@L["Nav.Reviews"]
        </a>
        <a class="app-nav-link @(IsActive("AuditLogs") ? "active" : "")"
           asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">
            <i class="bi bi-clock-history me-1"></i>@L["Nav.AuditLogs"]
        </a>
        <a class="app-nav-link @(IsActive("Settings") ? "active" : "")"
           asp-area="Admin" asp-controller="Settings" asp-action="Index">
            <i class="bi bi-gear me-1"></i>@L["Nav.Settings"]
        </a>
    </nav>

    <div class="app-shell">
        <main class="app-content" id="appContent">
            <div class="app-content-inner">
                <div class="mb-3">
                    @await Html.PartialAsync("_Alerts")
                </div>
                @RenderBody()
            </div>
        </main>
    </div>

    @await Html.PartialAsync("_LayoutScripts")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>