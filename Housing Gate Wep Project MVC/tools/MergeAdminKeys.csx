string EscapeXml(string s) => s.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;").Replace("'", "&apos;");

void MergeExtra(string path, Dictionary<string, string> extra)
{
    var content = File.ReadAllText(path, Encoding.UTF8);
    var sb = new StringBuilder();
    foreach (var kv in extra)
    {
        sb.AppendLine($"  <data name=\"{EscapeXml(kv.Key)}\" xml:space=\"preserve\">");
        sb.AppendLine($"    <value>{EscapeXml(kv.Value)}</value>");
        sb.AppendLine($"  </data>");
    }
    content = content.Replace("</root>", sb.ToString() + "</root>");
    File.WriteAllText(path, content, utf8NoBom);
    Console.WriteLine($"Re-merged {extra.Count} extra keys into {path}");
}

var adminEnPath = Path.Combine(root, "Resources", "Areas", "AdminAreaResource.resx");
var adminArPath = Path.Combine(root, "Resources", "Areas", "AdminAreaResource.ar-EG.resx");

MergeExtra(adminEnPath, adminKeysEn);
MergeExtra(adminArPath, adminKeysAr);

Console.WriteLine("Done");
