{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=HousingGate;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PropertyReviewSettings": {
    "RequireReviewOnLocationChange": true,
    "RequireReviewOnBedroomCountChange": true,
    "RequireReviewOnBathroomCountChange": false,
    "RequireReviewOnPropertyTypeChange": true,
    "RequireReviewOnFurnishingChange": true,
    "RequireReviewOnAmenityChange": true
  },
  "AllowedHosts": "*"
}
