@{
    ViewData["Title"] = L["Nav.About"];
}

<section class="py-5">
    <div class="container" style="max-width: 820px;">
        <div class="text-center mb-5">
            <span class="badge badge-primary-soft px-3 py-2 mb-3"><i class="bi bi-heart me-1"></i>@L["Nav.About"]</span>
            <h1 class="fw-bold mb-3">@L["Home.AboutTitle"]</h1>
            <p class="lead text-muted mb-0">@L["About.Lead"]</p>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <p class="text-muted mb-0">@L["About.Body"]</p>
            </div>
        </div>

        <h5 class="fw-bold mb-3">@L["About.DifferentTitle"]</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="feature-check mb-2"><i class="bi bi-patch-check-fill"></i></div>
                        <h6 class="fw-bold mb-1">@L["About.Point1Title"]</h6>
                        <p class="text-muted small mb-0">@L["About.Point1Text"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="feature-check mb-2"><i class="bi bi-people-fill"></i></div>
                        <h6 class="fw-bold mb-1">@L["About.Point2Title"]</h6>
                        <p class="text-muted small mb-0">@L["About.Point2Text"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="feature-check mb-2"><i class="bi bi-shield-shaded"></i></div>
                        <h6 class="fw-bold mb-1">@L["About.Point3Title"]</h6>
                        <p class="text-muted small mb-0">@L["About.Point3Text"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="feature-check mb-2"><i class="bi bi-hand-thumbs-up"></i></div>
                        <h6 class="fw-bold mb-1">@L["About.Point4Title"]</h6>
                        <p class="text-muted small mb-0">@L["About.Point4Text"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>