@{
    ViewData["Title"] = L["Nav.HowItWorks"];
}

<section class="py-5">
    <div class="container" style="max-width: 820px;">
        <div class="text-center mb-5">
            <span class="badge badge-primary-soft px-3 py-2 mb-3"><i class="bi bi-signpost-2 me-1"></i>@L["Nav.HowItWorks"]</span>
            <h1 class="fw-bold mb-0">@L["Nav.HowItWorks"]</h1>
        </div>

        <div class="steps-vertical">
            <div class="step-item">
                <span class="step-badge">1</span>
                <div class="step-body">
                    <h5 class="fw-bold mb-1">@L["HiW.Step1Title"]</h5>
                    <p class="text-muted mb-0">@L["HiW.Step1Text"]</p>
                </div>
            </div>
            <div class="step-item">
                <span class="step-badge">2</span>
                <div class="step-body">
                    <h5 class="fw-bold mb-1">@L["HiW.Step2Title"]</h5>
                    <p class="text-muted mb-0">@L["HiW.Step2Text"]</p>
                </div>
            </div>
            <div class="step-item">
                <span class="step-badge">3</span>
                <div class="step-body">
                    <h5 class="fw-bold mb-1">@L["HiW.Step3Title"]</h5>
                    <p class="text-muted mb-0">@L["HiW.Step3Text"]</p>
                </div>
            </div>
            <div class="step-item">
                <span class="step-badge">4</span>
                <div class="step-body">
                    <h5 class="fw-bold mb-1">@L["HiW.Step4Title"]</h5>
                    <p class="text-muted mb-0">@L["HiW.Step4Text"]</p>
                </div>
            </div>
            <div class="step-item">
                <span class="step-badge">5</span>
                <div class="step-body">
                    <h5 class="fw-bold mb-1">@L["HiW.Step5Title"]</h5>
                    <p class="text-muted mb-0">@L["HiW.Step5Text"]</p>
                </div>
            </div>
            <div class="step-item">
                <span class="step-badge">6</span>
                <div class="step-body">
                    <h5 class="fw-bold mb-1">@L["Layout.NeedHelp"]</h5>
                    <p class="text-muted mb-0">@L["HiW.Step6Text"]</p>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-center mt-5">
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg px-4">@L["HiW.GetStarted"]</a>
            <a asp-area="Student" asp-controller="Search" asp-action="Index" class="btn btn-soft btn-lg px-4"><i class="bi bi-search me-1"></i>@L["HiW.BrowseHousing"]</a>
        </div>
    </div>
</section>