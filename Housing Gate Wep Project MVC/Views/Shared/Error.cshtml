@model ErrorViewModel
@{
    ViewData["Title"] = L["Error.Title"];
}

<div class="container py-5 text-center">
    <div class="empty-state"><i class="bi bi-exclamation-triangle"></i></div>
    <h1 class="fw-bold mt-3">@L["Error.Title"]</h1>
    <p class="text-muted">@L["Error.SomethingWentWrong"]</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">
            <strong>@L["Error.RequestId"]:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">@L["Account.BackToHome"]</a>
</div>