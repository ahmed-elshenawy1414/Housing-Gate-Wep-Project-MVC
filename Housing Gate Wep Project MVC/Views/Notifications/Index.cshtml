@model IReadOnlyList<StudentHousing.Models.Notification>
@{
    ViewData["Title"] = L["Nav.Notifications"];
}

<div class="container py-4" style="max-width: 780px;">
    <div class="page-head d-flex align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="mb-0">@L["Nav.Notifications"]</h1>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-check2-circle"></i>
            <p>@L["Nav.AllCaughtUp"]</p>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var n in Model)
            {
                <div class="list-group-item d-flex gap-3 @(n.IsRead ? "" : "list-group-item-primary") border-0 border-bottom">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2">
                            <div class="fw-semibold">@n.Title</div>
                            @if (!n.IsRead)
                            {
                                <span class="badge badge-primary-soft">@L["Nav.New"]</span>
                            }
                        </div>
                        <div class="text-muted small">@n.Message</div>
                        <small class="text-secondary">@n.CreatedAt.ToLocalTime().ToString("g")</small>
                    </div>
                    @if (!string.IsNullOrEmpty(n.Link))
                    {
                        <a href="@n.Link" class="btn btn-sm btn-soft align-self-center">@L["Common.View"]</a>
                    }
                </div>
            }
        </div>
    }
</div>