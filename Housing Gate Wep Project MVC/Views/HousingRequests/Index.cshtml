@model PaginatedResult<StudentHousing.ViewModels.Student.HousingRequestCardViewModel>
@{
    ViewData["Title"] = "Housing Requests";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold mb-0">Students Looking for Housing</h1>
        <a asp-area="Student" asp-controller="HousingRequests" asp-action="Create" class="btn btn-primary">Post Your Request</a>
    </div>
    <form method="get" class="card mb-4">
        <div class="card-body row g-2">
            <div class="col-md-4"><input type="text" name="city" value="@Context.Request.Query["city"]" class="form-control" placeholder="City" /></div>
            <div class="col-md-4"><input type="text" name="university" value="@Context.Request.Query["university"]" class="form-control" placeholder="University" /></div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Filter</button></div>
        </div>
    </form>
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5 text-muted">No requests yet. Be the first to post!</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var r in Model.Items)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-light text-dark">@r.PropertyType</span>
                                <span class="badge @(r.PreferredGender==TenantGender.Any?"bg-secondary":"bg-primary")">@r.PreferredGender</span>
                            </div>
                            <h5 class="fw-bold">@r.Title</h5>
                            <p class="text-muted small mb-2">@r.City @if(!string.IsNullOrEmpty(r.University)){<span>• @r.University</span>}</p>
                            <p class="small mb-2">@r.Bedrooms bd • @r.BudgetMin.ToString("N0") - @r.BudgetMax.ToString("N0") EGP</p>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="avatar-initials avatar-sm">@r.StudentName.FirstOrDefault()</span>
                                <span class="small">@r.StudentName @(r.StudentIsVerified ? "✓ Verified" : "")</span>
                            </div>
                            <small class="text-muted">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") • @r.OffersCount offers</small>
                        </div>
                        <div class="card-footer bg-white">
                            <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary w-100">View & Offer</a>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4 d-flex justify-content-center gap-2">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-action="Index" asp-route-page="@i" asp-route-city="@Context.Request.Query["city"]" asp-route-university="@Context.Request.Query["university"]" class="btn btn-sm @(i==Model.Page?"btn-primary":"btn-outline-primary")">@i</a>
                }
            </nav>
        }
    }
</div>
